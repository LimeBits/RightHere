    "Show icons next to items in the Finder context menu.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 右键菜单的每个菜单项旁边显示图标。"
          }
        }
      }
    },
