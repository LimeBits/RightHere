        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈："
          }
        }
      }
    },
    "Finder extension: checking": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 扩展状态：正在检查"
          }
        }
      }
    },
    "Finder extension: enabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 扩展状态：已启用"
          }
        }
      }
    },
    "Finder extension: not enabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 扩展状态：未启用"
          }
        }
      }
    },
    "Finder extension: not found by the system": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
