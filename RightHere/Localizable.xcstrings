{
  "sourceLanguage": "en",
  "strings": {
    "%1$@ File (.%2$@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 文件 (.%2$@)"
          }
        }
      }
    },
    "Add File or Folder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加文件或文件夹"
          }
        }
      }
    },
    "Add files, folders, or hidden paths to reach them from the Finder context menu.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加文件、文件夹或手动输入隐藏路径，之后可从 Finder 右键菜单快速前往。"
          }
        }
      }
    },
    "Add frequently used files, folders, or hidden paths to reach them from the Finder context menu.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加常用文件、文件夹或隐藏路径，之后可从 Finder 右键菜单快速前往。"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级"
          }
        }
      }
    },
    "Applies to the settings window and the Finder context menu, including the names of newly created files.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用于设置页和 Finder 右键菜单，也包括新建文件的名称。"
          }
        }
      }
    },
    "Automatic Updates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本更新"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Check GitHub Releases for the latest stable version now.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即检查 GitHub Release 上的最新正式版本。"
          }
        }
      }
    },
    "Check Manually": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动检查"
          }
        }
      }
    },
    "Check for Updates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新…"
          }
        }
      }
    },
    "Check for new versions automatically. You can still check manually from the menu bar.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查新版本。仍可从菜单栏手动检查更新。"
          }
        }
      }
    },
    "Context Menu": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键菜单"
          }
        }
      }
    },
    "Copy Containing Folder Path": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制所在文件夹路径"
          }
        }
      }
    },
    "Copy Diagnostic Info": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制诊断信息"
          }
        }
      }
    },
    "Copy Diagnostics": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制诊断"
          }
        }
      }
    },
    "Copy File Name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制文件名"
          }
        }
      }
    },
    "Copy File Name Without Extension": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制不带扩展名文件名"
          }
        }
      }
    },
    "Copy Full Path": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制完整路径"
          }
        }
      }
    },
    "Copy Markdown Link": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制 Markdown 链接"
          }
        }
      }
    },
    "Copy full paths, file names, or Markdown links from the context menu. Multiple selections produce one result per line.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键菜单中复制完整路径、文件名或 Markdown 链接；多选时每行一个结果。"
          }
        }
      }
    },
    "Copy the version, templates folder, and recent Finder call status for troubleshooting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制版本、模板目录和最近 Finder 调用状态，方便排查。"
          }
        }
      }
    },
    "Could not parse the update information. Try again later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新信息解析失败，请稍后再试。"
          }
        }
      }
    },
    "Could not reach GitHub Releases. Try again later, or open the project page directly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 GitHub Releases。请稍后再试，或直接打开项目页面查看。"
          }
        }
      }
    },
    "Current Version": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本"
          }
        }
      }
    },
    "Current version: %1$@\nLatest version: %2$@\n\n%3$@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本：%1$@\n最新版本：%2$@\n\n%3$@"
          }
        }
      }
    },
    "Custom Templates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义模板"
          }
        }
      }
    },
    "Debug builds have no Sparkle public key, so automatic checks are disabled to avoid false update failures. Manual checks still work.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug 构建没有 Sparkle 公钥，自动检查已停用，避免误报更新失败。仍可手动检查。"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "Desktop": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面"
          }
        }
      }
    },
    "Dev Tools": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发工具"
          }
        }
      }
    },
    "Diagnostics": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断信息"
          }
        }
      }
    },
    "Diagnostics Copied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断信息已复制"
          }
        }
      }
    },
    "Diagnostics do not include template contents or your file contents.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断信息不包含模板正文或用户文件内容。"
          }
        }
      }
    },
    "Documents": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文稿"
          }
        }
      }
    },
    "Downloads": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载"
          }
        }
      }
    },
    "Enable the RightHere Finder extension in System Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中启用 RightHere 的 Finder 扩展。"
          }
        }
      }
    },
    "Enter Go To Path": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入快捷前往路径"
          }
        }
      }
    },
    "Enter Path": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入路径"
          }
        }
      }
    },
