    "Updates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新"
          }
        }
      }
    },
    "Useful for checking whether the Finder extension is enabled. Some macOS versions only open the main System Settings page.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于排查 Finder 扩展启用状态；不同 macOS 版本可能只打开系统设置主页。"
          }
        }
      }
    },
    "Word Document (.docx)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Word 文档 (.docx)"
          }
        }
      }
    },
    "You are up to date": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前已是最新版本"
          }
        }
      }
    },
    "You can paste this straight into a GitHub issue. Diagnostics do not include template contents or your file contents.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以直接粘贴到 GitHub Issue 中。诊断信息不包含模板正文或用户文件内容。"
          }
        }
      }
    }
