    "Rename Go To Item": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重命名快捷前往项"
          }
        }
      }
    },
    "Report an Issue…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈问题…"
          }
        }
      }
    },
    "Rich Text (.rtf)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "富文本文件 (.rtf)"
          }
        }
      }
    },
    "RightHere %@ is the latest version on GitHub Releases.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightHere %@ 已经是 GitHub Releases 上的最新版本。"
          }
        }
      }
    },
    "RightHere Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightHere 设置"
          }
        }
      }
    },
    "RightHere cannot read the Finder extension status right now.\n\n%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightHere 暂时无法读取 Finder 扩展状态。\n\n%@"
          }
        }
      }
    },
    "RightHere is installed, but its Finder extension is not enabled yet. Enable RightHere in System Settings, then restart Finder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightHere 已安装，但 Finder 扩展还没有启用。请在系统设置中启用 RightHere，然后重启 Finder。"
          }
        }
      }
    },
    "RightHere is installed, but the system did not find its Finder extension. This usually means an unsigned or signature-skipped test build was installed. Use a signed installer, or rebuild with your own Apple Developer account.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightHere 已安装，但系统没有发现它的 Finder 扩展。常见原因是安装了未签名/跳过签名的测试包。请换用已签名安装包，或用自己的 Apple Developer 账号重新构建。"
          }
        }
      }
    },
    "RightHere is temporarily hidden from the Finder context menu.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RightHere 暂时不会在 Finder 右键菜单中显示。"
          }
        }
      }
    },
    "Select the templates to show in the Finder context menu. Add templates using names like template.rtf.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选要显示在 Finder 右键菜单中的模板。使用 template.rtf 这样的命名添加模板。"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中显示"
          }
        }
      }
    },
    "System Extension Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统扩展设置"
          }
        }
      }
    },
    "Templates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板"
          }
        }
      }
    },
    "Terminal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端"
          }
        }
      }
    },
    "The system did not return a Finder extension status.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统暂时没有返回 Finder 扩展状态。"
          }
        }
      }
    },
    "The system is not allowing RightHere to read the Finder extension list right now. This does not mean the extension is unavailable; confirm RightHere under Extensions in System Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统暂时不允许 RightHere 读取 Finder 扩展列表。这不代表扩展不可用；请在系统偏好设置的“扩展”中确认 RightHere。"
          }
        }
      }
    },
    "This build may not be signed correctly, or the system has not registered the embedded extension yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前安装包可能未正确签名，或系统尚未注册内嵌扩展。"
          }
        }
      }
    },
    "Tools": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具"
          }
        }
      }
    },
    "Turning this off removes New File from the Finder context menu.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后 Finder 右键菜单里的“新建文件”会消失。"
          }
        }
      }
    },
    "Unknown Version": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
