        }
      }
    },
    "Open Releases Page": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开项目发布页"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置"
          }
        }
      }
    },
    "Open Templates Folder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开模板文件夹"
          }
        }
      }
    },
    "Open a terminal or editor at that folder when you right-click a folder or its background. Only apps installed on this Mac appear.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键文件夹或文件夹空白处时，在该目录打开终端或编辑器。只显示本机已安装的 App。"
          }
        }
      }
    },
    "Open the templates folder and add template.txt, template.md, or template.rtf.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开模板文件夹，添加 template.txt、template.md 或 template.rtf。"
          }
        }
      }
    },
    "Plain Text (.txt)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本文件 (.txt)"
          }
        }
      }
    },
    "PowerPoint Presentation (.pptx)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerPoint 演示文稿 (.pptx)"
          }
        }
      }
    },
    "Quit RightHere": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 RightHere"
          }
        }
      }
    },
    "Reading the system extension registration state.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
