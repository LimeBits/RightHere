    "Follow System": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        }
      }
    },
    "Go To": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷前往"
          }
        }
      }
    },
    "Drag items to set their Finder menu order.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动项目可调整 Finder“前往”菜单中的显示顺序。"
          }
        }
      }
    },
    "Drag to reorder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动调整顺序"
          }
        }
      }
    },
    "Help & Feedback": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮助与反馈"
          }
        }
      }
    },
    "Hidden paths and ~ are supported, for example ~/.zshrc, /etc/hosts, or ~/.codex.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持隐藏路径和 ~，例如 ~/.zshrc、/etc/hosts、~/.codex。"
          }
        }
      }
    },
    "Home": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户主目录"
          }
        }
      }
    },
    "If the context menu still does not appear, open your home folder in Finder and right-click the background.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果右键菜单仍未出现，请在 Finder 中打开用户目录后右键空白处。"
          }
        }
      }
    },
    "Language": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言"
          }
        }
      }
    },
